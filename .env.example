# Graphiti MCP Server 配置範例
# ============================
# 此文件列出所有被 src/config.py 實際讀取的環境變數。
# 複製為 .env 後修改對應的值即可：cp .env.example .env

# ======================
# Neo4j 圖資料庫（必填）
# ======================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password   # ← 必須修改
NEO4J_DATABASE=neo4j

# ======================
# LLM 提供者切換
# ======================
# 可選：ollama（預設，本地）/ glm（智谱 AI）/ groq（高速雲端）
#       openrouter（聚合各家模型）/ deepseek（深度求索）
LLM_PROVIDER=ollama

# Embedding 提供者（預設跟隨 LLM_PROVIDER，可獨立覆蓋）
# 可選：ollama / glm。雲端 LLM（groq / openrouter / deepseek）不提供 Embedding，
# 未設定時會自動使用 Ollama 嵌入器（bge-m3）。
# EMBEDDING_PROVIDER=ollama

# ----------------------
# GLM（智谱 AI）— LLM_PROVIDER=glm 時必填
# ----------------------
# GLM_API_KEY=your_glm_api_key
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL=glm-4-flash
# GLM_EMBEDDING_MODEL=embedding-3
# GLM_EMBEDDING_DIMENSIONS=1024

# ----------------------
# GROQ — LLM_PROVIDER=groq 時必填（不提供 Embedding，需搭配 Ollama 嵌入器）
# ----------------------
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=llama-3.3-70b-versatile

# ----------------------
# OpenRouter — LLM_PROVIDER=openrouter 時必填（不提供 Embedding）
# ----------------------
# OPENROUTER_API_KEY=your_openrouter_api_key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=stepfun/step-3.5-flash:free

# ----------------------
# DeepSeek（深度求索）— LLM_PROVIDER=deepseek 時必填（不提供 Embedding，需搭配 Ollama 嵌入器）
# ----------------------
# DEEPSEEK_API_KEY=your_deepseek_api_key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型：deepseek-chat / deepseek-reasoner（兩者將於 2026-07-24 下線）
#       新模型：deepseek-v4-flash（速度快，推薦）/ deepseek-v4-pro（效果更佳）
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TEMPERATURE=0.1
# DEEPSEEK_MAX_TOKENS=4096

# ======================
# Ollama LLM 模型
# ======================
# 主模型：用於實體提取、邊提取等複雜任務
# 推薦 qwen2.5:3b（速度與穩定性最佳平衡，~2s/call）
# 可選 qwen2.5:7b（效果更好但慢 5-10 倍）
OLLAMA_MODEL=qwen2.5:3b

# 小模型：用於去重判斷、摘要生成、時間解析等簡單任務
# graphiti-core pipeline 會自動在簡單任務使用小模型
# 未設定時自動回退為主模型。當有更快且穩定的小模型時可替換。
# 注意：qwen2.5:1.5b 結構化 JSON 輸出不穩定（成功率 33%），不建議使用
OLLAMA_SMALL_MODEL=qwen2.5:3b

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEMPERATURE=0.1
# 強制 LLM 輸出語言（如 "Traditional Chinese"），未設定時由模型自行決定
OLLAMA_TARGET_LANGUAGE=Traditional Chinese

# ======================
# Ollama 嵌入模型
# ======================
# 用於向量搜尋，維度必須與模型一致
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDING_BASE_URL=http://localhost:11434
# bge-m3 原生 1024 維（非 MRL 模型，截斷至 768 會語義失真，故用原生維度）
OLLAMA_EMBEDDING_DIMENSIONS=1024
# graphiti-core 搜尋零向量 fallback 維度（需與實際 embedding 維度一致）
EMBEDDING_DIM=1024

# ======================
# Cross-Encoder（重排序 / Reranker）
# ======================
# 控制搜尋結果的相關性重排，直接影響 *_cross_encoder recipe 與進階搜尋的 precision。
#   none（預設）：不重排（pass-through），搜尋走 RRF 初篩順序，零額外成本。
#   llm：用任意 OpenAI 相容 provider 做相關性評分（不依賴 logprobs，通用）。
#        未指定 model/base_url/api_key 時自動沿用目前 LLM_PROVIDER 的設定。
#   bge：本地 BAAI/bge-reranker-v2-m3（中文最佳、無 API 成本），需先安裝：
#        uv sync --extra reranker（首次使用下載約 1GB 模型）
# CROSS_ENCODER_PROVIDER=none
# CROSS_ENCODER_MODEL=
# CROSS_ENCODER_BASE_URL=
# CROSS_ENCODER_API_KEY=
# CROSS_ENCODER_TOP_N=10
# CROSS_ENCODER_MIN_SCORE=0.0

# ======================
# Query 前處理
# ======================
# query 正規化（全形轉半形、壓縮空白）總是啟用、零成本，無需設定。
# query 展開：用 LLM 產生同義詞/中英對照關鍵詞附加到查詢以提升召回。
# 預設關閉（每次搜尋會多一次 LLM 呼叫）。對稀疏圖、短查詢、跨語言查詢較有幫助。
# ENABLE_QUERY_EXPANSION=false
# QUERY_EXPANSION_TERMS=5

# ======================
# 伺服器設定
# ======================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_TRANSPORT=http

# ======================
# 日誌配置
# ======================
LOG_FILE=logs/graphiti_mcp_server.log
LOG_LEVEL=INFO
LOG_ROTATION_TYPE=time
LOG_ROTATION_INTERVAL=midnight
LOG_BACKUP_COUNT=30

# 第三方日誌級別覆蓋（JSON 格式，可選）
# GRAPHITI_LOG_THIRD_PARTY_LEVELS={"neo4j":"DEBUG"}

# ======================
# 顯示時區
# ======================
# API 回傳時間戳的顯示時區（存儲維持 UTC，僅輸出層轉換）
# 使用 IANA 時區名稱，如 Asia/Taipei、America/New_York、Europe/London
GRAPHITI_DISPLAY_TIMEZONE=Asia/Taipei

# ======================
# 伺服器回應語言（i18n）
# ======================
# MCP 工具回應訊息的語言。支援多語系，完整清單見 src/i18n.py 的 SUPPORTED_LANGUAGES。
# 常用：zh-TW（預設）、en、zh-CN、ja、pt-PT、pt-BR、ko、es、de、fr、he、ar、ru。
# REST API 不受此設定影響，改依 HTTP Accept-Language header 自動協商。
SERVER_LANG=zh-TW

# ======================
# 記憶效能配置
# ======================
# 觸發智慧切分的字元數閾值（超過此值自動分段處理）
GRAPHITI_CHUNK_THRESHOLD=800

# 切分後每段最大字元數
GRAPHITI_MAX_CHUNK_SIZE=600

# Graphiti 內部最大並行協程數（本地 LLM 建議 3-5，雲端可調高）
GRAPHITI_MAX_COROUTINES=10

# 是否預設使用背景處理模式（true 時 add_memory_simple 立即返回）
GRAPHITI_DEFAULT_BACKGROUND=false

# ======================
# Graphiti 進階設定
# ======================
SEARCH_LIMIT=20
ENABLE_DEDUPLICATION=true
PYDANTIC_VALIDATION_FIXES=true
COSINE_SIMILARITY_THRESHOLD=0.8

# ======================
# 重要性追蹤與智慧遺忘
# ======================
# 啟用存取追蹤（搜尋後自動更新 access_count 和 last_accessed）
ENABLE_IMPORTANCE_TRACKING=true

# 重要性權重（影響搜尋結果排序）
IMPORTANCE_WEIGHT=0.1

# 過時記憶判定：超過此天數未存取的視為過時
STALE_DAYS_THRESHOLD=30

# 過時記憶判定：存取次數低於此值的才列入
STALE_MIN_ACCESS_COUNT=2

# ======================
# 其他
# ======================
# 關閉遙測
GRAPHITI_TELEMETRY_ENABLED=false
